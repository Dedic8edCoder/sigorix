# Public site URL, no trailing slash. Used for canonical URLs, sitemap and OG tags.
# Leave empty until the production domain is known (canonical tags are then omitted).
SITE_URL=

# Public endpoint that receives contact-form POSTs (JSON). Example: a Formspree form URL.
# This value is embedded in public HTML - it must NOT be a secret.
# Leave empty and the form will honestly report that delivery is not configured.
FORM_ENDPOINT=

# Base path if hosting under a sub-path (e.g. GitHub Pages project site: /sigorix). Default: /
BASE_PATH=/
